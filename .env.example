# ============================================================
# BukiMind - Local Development (template)
# Copy to .env and fill in your own secrets.
# ============================================================

# Spring Boot Database
DB_URL=jdbc:postgresql://localhost:5433/bukimind?options=-c%20TimeZone=Asia/Ho_Chi_Minh
DB_USERNAME=bukimind
DB_PASSWORD=your_db_password


# PostgreSQL - Docker
POSTGRES_DB=bukimind
POSTGRES_USER=bukimind
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST_PORT=5433


# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent


# Cloudinary
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Moderation
AI_MODERATION_URL=https://simple-ai-moderation.onrender.com/moderate


# Keycloak PostgreSQL
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=your_keycloak_db_password
KEYCLOAK_DB_HOST_PORT=5434


# Keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password
KEYCLOAK_HOST_PORT=8180

# Issuer used by Spring Security for OIDC discovery / JWKS validation
# Realm: bukimind   |   Client: bukimind-frontend
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/bukimind

# Backend -> Keycloak proxy endpoints (/api/auth/*)
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=bukimind
# Client used for password / refresh grants (public frontend client)
KEYCLOAK_CLIENT_ID=bukimind-frontend
# Only if that client is confidential; leave empty for a public client
KEYCLOAK_CLIENT_SECRET=
# Backend service-account client (Client authentication + Service accounts ON)
KEYCLOAK_BACKEND_CLIENT_ID=bukimind-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=


# Frontend origins allowed by CORS (comma separated, no wildcard).
# Add the deployed frontend origin here (e.g. https://bukimind-frontend-ecru.vercel.app).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174



# Redis
REDIS_HOST_PORT=6379


# RedisInsight
REDISINSIGHT_HOST_PORT=5540